# ==========================
# Virtual Environments
# ==========================
venv/
.venv/

# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ==========================
# Environment Variables
# ==========================
# Gerçek API anahtarlarını taşır, ASLA commit'lenmez. Bu desen yalnızca
# ".env" adının kendisiyle eşleşir; anahtarsız şablon olan ".env.example"
# bilinçli olarak depoda TUTULUR (kullanıcı `cp .env.example .env` ile
# başlıyor). Şablona gerçek bir anahtar yazılmamalıdır.
.env

# ==========================
# Test & Coverage
# ==========================
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ==========================
# Logs & Reports
# ==========================
logs/
reports/

# ==========================
# IDE
# ==========================
.vscode/
.idea/

# ==========================
# AI Tooling (local caches / generated analysis output)
# ==========================
.serena/
graphify-out/
.claude/

# ==========================
# Operating System Files
# ==========================
.DS_Store
Thumbs.db

# ==========================
# Capture Samples
# ==========================
# Alt klasörleri de kapsamalı: capture'lar samples/clean/ ve
# samples/malicious/ altında tutuluyor, yalnızca .gitkeep izleniyor.
*.pcap
*.pcapng

# İstisna: depoya kasıtlı olarak eklenen sentetik demo capture. İçindeki tüm
# adresler RFC 5737 / RFC 1918 aralıklarındandır, gerçek bir ağa ait değildir.
# scripts/generate_sample_capture.py ile yeniden üretilebilir.
!samples/malicious/demo_capture.pcapng