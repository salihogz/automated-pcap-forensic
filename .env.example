# Threat Intelligence API keys.
#
# Copy this file to `.env` and fill in the keys you have:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file (`.env.example`)
# is the tracked template and must never contain a real key.
#
# Every provider is optional. One with no key configured is SKIPPED, not
# treated as an error (ThreatIntelProvider.is_configured()) — the tool runs
# fine with no `.env` at all, it just won't enrich IPs against that provider.
#
# Where to get a free key:
#   VirusTotal   https://www.virustotal.com/gui/my-apikey      (500 lookups/day)
#   AbuseIPDB    https://www.abuseipdb.com/account/api         (1000 checks/day)
#   AlienVault   https://otx.alienvault.com/api                (no documented cap)

VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
